PORT=5000
HOST=0.0.0.0

# Local frontend / production frontend URL(s), comma-separated
CORS_ORIGIN=https://www.bizvyapar.in,https://bizvyapar.in,https://bizvyapar-in-frontend.vercel.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Postgres on Render (optional if MONGODB_URI is set)
DATABASE_URL=
PGSSL=true

# MongoDB Atlas (preferred durable store for auth, payments, profiles)
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/bizvyapar?appName=bizvyapar
MONGODB_URI=
MONGODB_DB=bizvyapar

# Firebase Admin
FIREBASE_PROJECT_ID=finoverts
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@finoverts.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
WORKSHOP_AMOUNT_PAISE=100

# Webinar join link
WEBINAR_LINK=https://meet.google.com/your-webinar-link

# Auth JWT (name + email + phone login)
AUTH_JWT_SECRET=change-me-long-random-auth-jwt-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# TredsDash admin panel (/tredsdash)
ADMIN_DASHBOARD_NAME=TredsDash
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=change-me-long-random-secret

# Brevo SMTP (Settings → SMTP & API)
# SMTP_USER = Brevo Login (xxx@smtp-brevo.com)
# SMTP_PASS or SMTP_PASSWORD = Brevo SMTP key
# SMTP_FROM or SMTP_FROM_EMAIL = verified sender
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_PASSWORD=
SMTP_FROM=your-verified-sender@gmail.com
SMTP_FROM_EMAIL=
SMTP_SENDER_NAME=BizVyapar
SMTP_FROM_NAME=BizVyapar

# Reminders T-24h / T-30m before Sunday 5:00 PM
REMINDERS_ENABLED=true

# Keep-alive target
# KEEPALIVE_URL=https://your-api.onrender.com/health
