PORT=5000
CORS_ORIGIN=http://localhost:5173

# Firebase Admin
FIREBASE_PROJECT_ID=finoverts
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@finoverts.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
WORKSHOP_AMOUNT_PAISE=100

# Webinar join link emailed after payment
WEBINAR_LINK=https://meet.google.com/your-webinar-link

# Gmail SMTP only (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-gmail@gmail.com
SMTP_SENDER_NAME=Easy Vyapar
