# Copy these into Vercel → Project → Settings → Environment Variables
# Never commit real secrets.

# —— Frontend (Vite / VITE_*) ——
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=finoverts.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=finoverts
VITE_FIREBASE_STORAGE_BUCKET=finoverts.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_RAZORPAY_KEY_ID=

# —— Frontend → API (when backend is on Render) ——
# VITE_API_BASE_URL=https://bizvyapar-api.onrender.com

# —— Backend (Express on /api or Render) ——
# Your live frontend URL(s), comma-separated
CORS_ORIGIN=https://your-app.vercel.app

# Render Postgres connection string
DATABASE_URL=

RAZORPAY_WEBHOOK_SECRET=
REMINDERS_ENABLED=true

# Keep-alive: https://YOUR-SERVICE.onrender.com/health
KEEPALIVE_URL=

FIREBASE_PROJECT_ID=finoverts
FIREBASE_CLIENT_EMAIL=
# Paste full private key; keep \n as literal backslash-n or real newlines in Vercel UI
FIREBASE_PRIVATE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WORKSHOP_AMOUNT_PAISE=100

WEBINAR_LINK=https://meet.google.com/your-webinar-link

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=BizVyapar
